PORT=3010
# APP_URL=https://employee-hub.locdoc.net
SQLITE_DB_PATH=employee-hub-data.sqlite
DATA_BACKEND=sqlite
PRODUCT_DB_ENGINE=postgres
LAB_DEV_SIMPLE_AUTH=1
HUB_AUTH_ENABLED=0
HUB_AUTH_STRICT=1
HUB_APP_URL=http://localhost:3002
HUB_JWT_SECRET=
HUB_JWT_ISSUER=lab-hub

# --- Product database (postgres) ---
PRODUCT_DB_ENGINE=postgres
PRODUCT_DATABASE_URL=postgresql://app:app@localhost:5432/appdb
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=appdb

# PLATFORM_INTEGRATION=locdoc-platform
# Standalone: npm run dev (SQLite, local login)
# Shared Lab Postgres + Hub: npm run dev:postgres — see docs/PLATFORM_DEV.md
# Production loads DATABASE_URL and HUB_JWT_SECRET from Lab-Hub-Secrets using the ARN baked into the image.

# --- Google (Resources Drive folder + credit card Sheet) ---
# Local: path to the service account key file (git-ignored). Production: leave unset and put the
# key's contents in AWS Secrets Manager as GOOGLE_SERVICE_ACCOUNT_JSON (see GO-LIVE.md).
# GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Signs Resources PDF/video links. Production: a long random value from Secrets Manager.
# FILE_LINK_SECRET=

# Optional fallback: lets n8n post credit card data to /api/integrations/expense-tracking.
# N8N_INTEGRATION_KEY=
